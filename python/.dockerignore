# Python bytecode and cache
__pycache__/
*.pyc
.ruff_cache/
.coverage
.coverage.*

# Configuration, logs, and data directories.
# These are handled by volume mounts at runtime and should not be in the image.
config/
logs/
put/
shapefiles/
auth_cache/
temp/
cache/
TestPDFs/

# Docker and environment files are not needed inside the image
Dockerfile
.dockerignore
docker-compose*.yaml
docker-compose*.yml
.env
*.env

# Git directory
.git/
.gitignore
.gitattributes

# Development tooling
mise.toml
*.md

# Other cache/state files
previous_clients.yml
*.log
eval_results.jsonl
*.jsonl

get_token.py
