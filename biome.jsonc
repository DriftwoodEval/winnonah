{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedProperties": "on"
			}
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!src/app/_components/ui", "!**/*.yaml"]
	},
	"formatter": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"nursery": {
				"useTailwindSortedClasses": {
					"fix": "safe",
					"level": "warn"
				}
			},
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["../**"],
								"message": "Use the ~/, @components/, or @ui/ alias instead of a parent-relative import. Same-directory ./ imports are fine."
							}
						]
					}
				}
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"tailwind": {
		"mergeFunctions": ["clsx", "cn"],
		"stylesheet": "./src/styles/globals.css",
		"variantFunctions": ["cva"]
	}
}
